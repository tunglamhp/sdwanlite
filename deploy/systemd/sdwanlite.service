[Unit]
Description=SDWANLite edge node
After=network-online.target wg-quick@sdwanlite0.service
Wants=network-online.target

[Service]
Type=simple
User=sdwanlite
ExecStart=/usr/local/bin/sdwanlited /etc/sdwanlite/sdwanlite.toml
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/sdwanlite

[Install]
WantedBy=multi-user.target
